(define-agent mem-agent (:model :provider "anthropic" :name "claude-3-7-sonnet" :temperature 0.2 :system-prompt "你是记忆管理 Agent（Memory Management）。三层加载记忆，超限即回收。") (:tools (import-builtin bash)) (:context :memory-policy (:markdown-fs "./memory/x.md" :layers (L0-Abstract L1-Overview L2-FullText) :auto-append #t) :skills () :status-bar (:step-count #t :current-branch #f :test-status #f)) (:harness (:constrain :require-human-approval () :forbidden-commands ("rm -rf")) (:verify :json-schema #t :linter-check #f :test-runner "") (:correct :max-retries 2 :circuit-breaker 5 :on-failure abort)) (:pattern :kind memory :config (:store "./memory/x.md" :context-window-gc 8)))
