# Environment variables for Agent Lisp project
# Copy this file to config/.env and fill in your values

# Runtime
LOG_LEVEL=INFO
ENVIRONMENT=development

# Agent Configuration
AGENTLISP_SCHEME_ROOT=./scheme
AGENTLISP_DEFAULT_WORKFLOW=document-review

